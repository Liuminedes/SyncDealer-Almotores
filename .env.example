# ── Variables requeridas en Dokploy ──────────────────────────────────────────
# Copiar como .env en la raíz del proyecto para desarrollo local.
# En PRODUCCIÓN (Dokploy): configurar cada variable en la UI de Dokploy
# bajo "Environment Variables" del Compose.
# NUNCA subir el .env con valores reales al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Base de datos ─────────────────────────────────────────────────────────────
# DB_ROOT_PASSWORD es solo para el contenedor MySQL.
# DB_USER y DB_PASSWORD son los que usa el backend.
DB_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD_MYSQL
DB_NAME=sync_dealer_almotores
DB_USER=syncdealer_user
DB_PASSWORD=CAMBIAR_PASSWORD_DB

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=5001
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRET_ALEATORIO_DE_64_BYTES
JWT_EXPIRES_IN=8h

# CORS: URL completa del frontend SIN barra al final
CORS_ORIGIN=https://syncdealer.tudominio.com

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=CAMBIAR_HOST_SMTP
SMTP_PORT=587
SMTP_USER=CAMBIAR_USUARIO_SMTP
SMTP_PASS=CAMBIAR_PASSWORD_SMTP
SMTP_FROM=SyncDealer | Almotores <correo@tudominio.com>
HR_EMAIL=rrhh@tudominio.com

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL pública de la API (la que el browser usará para las peticiones)
# En Dokploy configurar como BUILD ARGUMENT del servicio frontend
VITE_API_URL=https://api.tudominio.com/api

# ── Puertos expuestos (solo para desarrollo local) ─────────────────────────
# En producción con Dokploy, el proxy reverso maneja los puertos
BACKEND_PORT=5001
FRONTEND_PORT=3000
