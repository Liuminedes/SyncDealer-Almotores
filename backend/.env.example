# ────────────────────────────────────────────────────────────────
#  SyncDealer Almotores — Variables de Entorno (EJEMPLO)
#  Copiar este archivo como .env en el servidor y completar valores reales.
#  NUNCA subir el .env real al repositorio.
# ────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5001

# ── Base de datos ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sync_dealer_almotores
DB_USER=syncdealer_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURA

# ── Autenticación JWT ────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRET_ALEATORIO_DE_64_BYTES
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────────
# En producción: URL del frontend desplegado (sin barra al final)
CORS_ORIGIN=https://tudominio.com

# ── SMTP (Correo) ────────────────────────────────────────────────
# TODOS estos campos son obligatorios. La app NO arranca sin ellos.
SMTP_HOST=CAMBIAR_POR_HOST_SMTP
SMTP_PORT=587
SMTP_USER=CAMBIAR_POR_USUARIO_SMTP
SMTP_PASS=CAMBIAR_POR_PASSWORD_SMTP
SMTP_FROM=SyncDealer | Desprendibles <correo@tudominio.com>
HR_EMAIL=rrhh@tudominio.com
